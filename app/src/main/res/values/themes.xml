<resources>
    <style name="Theme.Invernadero" parent="Theme.AppCompat.Light.DarkActionBar">
        <item name="colorPrimary">@color/primary_dark</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorAccent">@color/primary</item>
        <item name="android:windowBackground">@color/bg</item>
    </style>
    <style name="Btn" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/bg_button</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
    </style>
    <style name="BtnOutline" parent="Btn">
        <item name="android:background">@drawable/bg_button_outline</item>
        <item name="android:textColor">@color/primary_dark</item>
    </style>
    <style name="Input" parent="Widget.AppCompat.EditText">
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:padding">14dp</item>
        <item name="android:textSize">18sp</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textColorHint">#5F6F65</item>
        <item name="android:importantForAutofill">no</item>
    </style>
    <style name="Label">
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/ink2</item>
    </style>
</resources>

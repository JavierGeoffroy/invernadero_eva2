<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="24dp" android:gravity="center_horizontal">
        <ImageView android:layout_width="72dp" android:layout_height="72dp" android:layout_marginTop="24dp"
            android:src="@drawable/ic_leaf" android:importantForAccessibility="no" />
        <TextView android:text="Invernadero IoT" android:textSize="30sp" android:textStyle="bold"
            android:textColor="@color/ink" android:layout_marginTop="8dp"
            android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <TextView android:id="@+id/tvMsg" android:textSize="16sp" android:textColor="@color/ink2"
            android:layout_marginTop="12dp" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <TextView android:id="@+id/lblPin" style="@style/Label" android:text="PIN" android:labelFor="@+id/etPin"
            android:layout_marginTop="20dp" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <EditText android:id="@+id/etPin" style="@style/Input" android:hint="Ingresa tu PIN" android:inputType="numberPassword"
            android:layout_width="match_parent" android:layout_height="wrap_content" />
        <TextView android:id="@+id/lblPass" style="@style/Label" android:text="Clave compartida" android:labelFor="@+id/etPass"
            android:layout_marginTop="14dp" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <EditText android:id="@+id/etPass" style="@style/Input" android:hint="Mínimo 8 caracteres" android:inputType="textPassword"
            android:layout_width="match_parent" android:layout_height="wrap_content" />
        <Button android:id="@+id/btnLogin" style="@style/Btn" android:text="Entrar" android:layout_marginTop="22dp"
            android:layout_width="match_parent" android:layout_height="wrap_content" />
        <Button android:id="@+id/btnReset" style="@style/BtnOutline" android:text="Restablecer PIN y clave" android:layout_marginTop="12dp"
            android:layout_width="match_parent" android:layout_height="wrap_content" />
        <TextView android:text="Seguridad: tras 3 intentos fallidos el acceso se bloquea 30 segundos."
            android:textSize="14sp" android:textColor="@color/ink2" android:layout_marginTop="16dp"
            android:layout_width="match_parent" android:layout_height="wrap_content" />
    </LinearLayout>
</ScrollView>
